rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // An optional field that, when present, must be an http(s) URL. Accepts a
    // null/missing value so callers can omit the field entirely. Blocks
    // `javascript:`, `data:` and friends, which would otherwise be stored and
    // then rendered into an href or src.
    function isOptionalWebUrl(data, field, maxLength) {
      return !data.keys().hasAny([field]) ||
             data[field] == null ||
             (data[field] is string &&
              data[field].size() <= maxLength &&
              data[field].matches('^https?://[^\\s]+$'));
    }

    // Saved Trips
    match /saved_trips/{tripId} {
      function isValidTrip(data) {
        return data.keys().hasAll(['userId', 'title', 'content', 'createdAt']) &&
               data.userId is string &&
               data.title is string && data.title.size() <= 200 &&
               data.content is string && data.content.size() <= 20000 &&
               data.createdAt == request.time;
      }

      allow create: if isVerified() && isValidTrip(request.resource.data) && isOwner(request.resource.data.userId);
      allow get, list: if isOwner(resource.data.userId);
      allow delete: if isOwner(resource.data.userId);
    }

    // Reviews
    // Reviews are intentionally public, so anyone may read one. Collection reads
    // are still bounded: `allow read: if true` let a single client call pull the
    // entire collection. Requiring a limit means bulk extraction costs one
    // metered query per page instead of one unbounded one.
    match /reviews/{reviewId} {
      // A review may be linked back to the trip it was written about, so it can
      // be shown on that trip as well as in the global feed. Both halves are
      // optional and only accepted together: a `tripId` with no `tripTitle`
      // renders as a bare id in the UI, and a `tripTitle` on its own cannot be
      // resolved to a trip. A client must never be able to attach someone else's
      // trip to their review, so a linked id has to be one the author owns.
      function hasValidTripLink(data) {
        return (!data.keys().hasAny(['tripId', 'tripTitle']) ||
                (data.tripId == null && data.tripTitle == null)) ||
               (data.tripId is string && isValidId(data.tripId) &&
                data.tripTitle is string && data.tripTitle.size() > 0 &&
                data.tripTitle.size() <= 200 &&
                get(/databases/$(database)/documents/saved_trips/$(data.tripId)).data.userId == request.auth.uid);
      }

      function isValidReview(data) {
        return data.keys().hasAll(['destination', 'userId', 'userName', 'rating', 'review', 'createdAt']) &&
               data.keys().hasOnly(['destination', 'userId', 'userName', 'rating', 'review', 'createdAt',
                                    'userPhoto', 'videoUrl', 'tripId', 'tripTitle']) &&
               data.destination is string && data.destination.size() <= 200 &&
               data.userId is string && isValidId(data.userId) &&
               data.userName is string && data.userName.size() <= 100 &&
               data.rating is number && data.rating >= 1 && data.rating <= 5 &&
               data.review is string && data.review.size() <= 2000 &&
               data.createdAt == request.time &&
               isOptionalWebUrl(data, 'userPhoto', 2048) &&
               isOptionalWebUrl(data, 'videoUrl', 2048) &&
               hasValidTripLink(data);
      }

      allow create: if isVerified() && isValidReview(request.resource.data) && isOwner(request.resource.data.userId);
      allow update: if false; // Reviews are immutable; delete and repost instead.
      allow get: if true; // Public by design.
      allow list: if request.query.limit <= 50;
      allow delete: if isOwner(resource.data.userId);
    }
  }
}
