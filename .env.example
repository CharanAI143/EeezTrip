# EeezTrip - local development environment
#
# Copy to `.env` and fill in what you need. `.env` is gitignored; this file is
# the tracked, secret-free template.
#
#   cp .env.example .env
#
# Every value here is optional. With an empty file the backend starts, serves
# /api/health, and falls back to its curated template and catalogue data. The
# frontend builds and runs with Firebase disabled, which means no sign-in, no
# saved trips, and no reviews.
#
# Anything with a real value is a secret. Do not commit a filled-in copy.

# ─── Database (optional) ────────────────────────────────────────────────────
# Leave empty to run without MongoDB. For the bundled container:
#   docker compose --profile with-mongo up
# and set MONGODB_URI=mongodb://mongo:27017
MONGODB_URI=
MONGODB_DB_NAME=eeeztrip

# ─── AI providers (optional, tried in order) ───────────────────────────────
# First one that has a key wins. With none set, the provider chain is skipped
# and responses come from the deterministic fallbacks.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

OPENAI_API_KEY=

# Local Ollama needs no key. Under Docker, localhost is the container itself,
# so docker-compose.yml rewrites this to host.docker.internal:11434.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Deep mode gives the model longer to answer; the request timeout bounds a
# single provider call. Raising DEEP_MODE_TIMEOUT_SEC raises the whole budget.
DEEP_MODE_TIMEOUT_SEC=12
AI_REQUEST_TIMEOUT_SEC=90
AI_TEMPERATURE=0.5

# ─── External APIs (optional) ──────────────────────────────────────────────
# Used to ground recommendations in live prices and weather.
SERPAPI_API_KEY=

# ─── CORS (optional) ───────────────────────────────────────────────────────
# Comma-separated, no trailing slashes. Add your deployed frontend origin here
# or the browser will block it.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Firebase (frontend only) ──────────────────────────────────────────────
# These are VITE_ prefixed, so Vite inlines them into the client bundle at
# build time. They are not secret in the way a server key is - a Firebase web
# config is designed to ship to browsers - but the rules in firestore.rules are
# what actually protect your data. Restrict the API key by domain in the
# Firebase console.
#
# The Firebase web app config is at:
#   Firebase console > Project settings > General > Your apps > SDK setup
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=
