node_modules/
build/
dist/
coverage/
.DS_Store
*.log

# Real secrets. `.env.example` is the tracked, redacted template, so it has to
# be re-included: `.env*` alone would exclude it too.
.env*
!.env.example

__pycache__/
*.pyc

# Local Python environments for backend/requirements.txt. Without these the
# venv would show up as thousands of untracked files and risk being committed.
venv/
.venv/
